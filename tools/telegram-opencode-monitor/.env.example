# Bu dosyayi kopyalayip ".env" adiyla kaydedin (bu klasorde).
# .env dosyasi .gitignore ile git'e girmez.
# Token'i sohbete VEYA herhangi bir commit'e GONDERMEYIN;
# yalnizca lokal dosya veya Windows user environment variable olarak saklayin.
#
# Alternatif (PowerShell, yalnizca sizin kullanici hesabinizda):
#   [Environment]::SetEnvironmentVariable("TELEGRAM_BOT_TOKEN", "<deger>", "User")
#   [Environment]::SetEnvironmentVariable("TELEGRAM_CHAT_ID", "<deger>", "User")

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
